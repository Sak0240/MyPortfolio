{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "backend/{app/**,data/**,__init__.py}",
      "excludeFiles": "{node_modules,dist,.venv,src,public,knowledge,.git}/**"
    }
  }
}
