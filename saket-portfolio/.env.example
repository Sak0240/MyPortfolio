# --- Backend (Vercel dashboard -> Project -> Settings -> Environment Variables; never commit real values) ---
DEEPSEEK_API_KEY=
# Optional:
# DEEPSEEK_MODEL=deepseek-chat
# ALLOWED_ORIGINS=https://your-custom-domain.com
# RATE_LIMIT_PER_MINUTE=10
# Postgres connection string: stores each question + outcome for `python -m backend.analytics_report`.
# Without it, questions are only written to the function logs.
# DATABASE_URL=postgresql://user:password@host/db

# --- Frontend (local development only, in .env.local) ---
# Point the terminal at a backend running locally with: uvicorn backend.app.main:app --port 8000
# VITE_CHAT_API=http://localhost:8000/api/chat
